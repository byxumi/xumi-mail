{
  "name": "cf-temp-mail-next",
  "version": "1.0.0",
  "private": true,
  "description": "临时邮箱系统 - Next.js + Cloudflare Workers 单一 Worker 部署",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx scripts/smoke-test.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "test": "npm run test:core && npm run test:integration",
    "db:init": "wrangler d1 execute cf_temp_mail --file=db/schema.sql",
    "db:init:local": "wrangler d1 execute cf_temp_mail --local --file=db/schema.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "framer-motion": "^13.5.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.49.0",
    "mimetext": "^3.0.28",
    "postal-mime": "^2.7.6",
    "resend": "^6.28.0",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "15.5.26",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
